# Settings for scripts/run-local-services.sh on Monad mainnet, next to the testnet pair. Not for secrets:
# keys stay in .env (the same KEEPER_PRIVATE_KEY and MAKER_PRIVATE_KEY sign on both chains; nonces are per
# chain, so the two pairs never race). Copy to .run/mainnet/services.env and run with its own run dir
# (pid, log and, by default, this settings file live there):
#
#   RUN_DIR=$PWD/.run/mainnet LAUNCHD_PREFIX=xyz.playhunch.book.mainnet bash scripts/run-local-services.sh config
#
# Off testnet the keeper's state and health files and the maker's health file are named after the network
# by default (health.monad-mainnet.json, ...), so they never collide with the testnet pair's.
#
# Both services start as a dry run. Turn each on (KEEPER_ENABLED=1, MAKER_ENABLED=1) only after its
# dry-run log reads right against the mainnet deployment.

KEEPER_NETWORK=monad-mainnet
MAKER_NETWORK=monad-mainnet

# Keeper: dry run until checked.
KEEPER_ENABLED=0
KEEPER_HEALTH_PORT=8783
# Ask Kuru for a market's book once its pool is halfway to the graduation rule, so Kuru has time to
# create it before the pool fills (Kuru creates mainnet books by hand).
KEEPER_BOOK_REQUEST_AT=0.5
# Post book requests and alerts somewhere a person reads them (Slack, Discord or any JSON webhook).
# KEEPER_ALERT_WEBHOOK=https://hooks.example.com/...
# No oracle pokes or Kuru v2 feeds on the mainnet Kuru v1 stack (each poke costs gas), and no recurring
# series until a series file for mainnet is written and funded.
KEEPER_JOBS_OFF=oracle,kuruFeeds,series
KEEPER_MIN_MON=1

# Maker: dry run until checked. Requotes cost about 0.06 MON each on mainnet, so requote on a full
# spread's move and refresh once a day.
MAKER_ENABLED=0
MAKER_HEALTH_PORT=8784
MAKER_REQUOTE_THRESHOLD=0.02
MAKER_HEARTBEAT_SECONDS=86400
MAKER_POLL_SECONDS=30
MAKER_ORDER_SIZE=20
MAKER_INVENTORY_CAP=100
