# Settings for scripts/run-local-services.sh, as Hunch Book runs them on Monad testnet.
# Copy to .run/services.env (gitignored). Not for secrets: keys stay in .env, and the script refuses
# any *PRIVATE_KEY*, *SECRET*, *TOKEN* or *MNEMONIC* name here. A variable set in your shell wins.

# Keeper: send transactions (otherwise a dry run that only logs what it would do).
KEEPER_ENABLED=1
KEEPER_HEALTH_PORT=8781
# Implied-probability oracle pokes every 2 hours, to save testnet gas. Kuru v2 stacks still poke every
# open market at most every KEEPER_KURU_POKE_SECONDS (default 900): Kuru's withdrawal limiter needs fresh feeds.
KEEPER_ORACLE_POKE_SECONDS=7200
# Recurring series (docs/SERIES.md). Point the file at your copy of services/keeper/series.example.json.
KEEPER_SERIES_ENABLED=1
KEEPER_SERIES_FILE=/absolute/path/to/hunch-book/.run/series.json

# Maker: quote for real (otherwise a dry run).
MAKER_ENABLED=1
MAKER_HEALTH_PORT=8782
MAKER_HEARTBEAT_SECONDS=3600
MAKER_REQUOTE_THRESHOLD=0.01
MAKER_POLL_SECONDS=20
