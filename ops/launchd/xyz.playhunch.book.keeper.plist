<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hunch Book keeper as a macOS launchd agent. A template: replace __REPO__ with the repository's absolute
  path and __NODE__ with the absolute path of Node 22 (`command -v node`). Install steps: ops/README.md.
  The keeper loads __REPO__/.env itself and takes only KEEPER_*, MONAD_*, INDEXER_URL and PYTH_API_KEY.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>xyz.playhunch.book.keeper</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--import</string>
    <string>tsx</string>
    <string>src/main.ts</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__/services/keeper</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>KEEPER_ENV_FILE</key>
    <string>__REPO__/.env</string>
    <key>KEEPER_HEALTH_PORT</key>
    <string>8781</string>
  </dict>

  <!-- Start at login; restart after a crash, but not after a clean stop. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- Seconds between SIGTERM and SIGKILL on stop: the keeper finishes its cycle. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/.run/keeper.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/.run/keeper.log</string>
</dict>
</plist>
