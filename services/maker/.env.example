# Hunch Book maker kit: every setting the bot reads, with its default. Names only: put your own key in
# your environment or in a .env file that is never committed. docs/MAKER-KIT.md explains each one.
# Lines starting with # are optional settings left at their default.

# --- Mode and key -------------------------------------------------------------------------------
# "live" (default) or "paper". Paper never sends a transaction and needs no key.
MAKER_MODE=paper
# Starting USDC of the paper account.
MAKER_PAPER_USDC=1000
# Live only: the kill switch (1 to send) and your key. Leave the key empty until you go live.
MAKER_ENABLED=0
# MAKER_PRIVATE_KEY=

# --- Network ------------------------------------------------------------------------------------
# monad-testnet or monad-mainnet
MAKER_NETWORK=monad-testnet
# Optional RPC override (otherwise MONAD_TESTNET_RPC or MONAD_MAINNET_RPC, then the public RPC).
# MAKER_RPC_URL=
MAKER_RPC_RPS=10

# --- What to quote ------------------------------------------------------------------------------
# Comma-separated market addresses; empty: every graduated market.
# MAKER_MARKETS=
# Comma-separated template ids; empty: every template with a model (1 to 6).
# MAKER_TEMPLATES=

# --- Quotes and risk limits ---------------------------------------------------------------------
MAKER_INVENTORY_CAP=100
MAKER_ORDER_SIZE=20
MAKER_LEVELS=1
MAKER_LEVEL_STEP=0.01
MAKER_HALF_SPREAD=0.015
MAKER_SKEW=0.02
MAKER_REQUOTE_THRESHOLD=0.005
MAKER_HEARTBEAT_SECONDS=300
MAKER_POLL_SECONDS=10
MAKER_CLOSE_BUFFER_SECONDS=120
MAKER_WIDEN_SECONDS=3600
MAKER_WIDEN_MAX=3
MAKER_DUST=1

# --- Gas ----------------------------------------------------------------------------------------
MAKER_MAX_GAS_PRICE_GWEI=200
MAKER_MAX_GAS_PER_TX=3000000

# --- Health -------------------------------------------------------------------------------------
# MAKER_HEALTH_FILE=
# MAKER_HEALTH_PORT=
