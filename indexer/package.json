{
  "name": "@hunch-book/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Envio HyperIndex indexer for Hunch Book: markets, stakes, graduations, Kuru fills on our books, positions, settlements, redemptions and proof-page stats.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "codegen": "envio codegen",
    "gen-config": "tsx scripts/gen-config.ts",
    "gen-config:check": "tsx scripts/gen-config.ts --check",
    "dev": "tsx scripts/envio.ts dev",
    "dev:mainnet": "tsx scripts/envio.ts dev --network mainnet",
    "start": "tsx scripts/envio.ts start",
    "start:mainnet": "tsx scripts/envio.ts start --network mainnet",
    "stop": "envio stop",
    "typecheck": "envio codegen && tsc -p tsconfig.json --noEmit",
    "test": "envio codegen && vitest run"
  },
  "dependencies": {
    "envio": "3.12.1",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "graphql": "17.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
